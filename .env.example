# Example environment variables for neo-py
# Copy this file to .env and fill in your local values. Never commit .env.

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=replace-with-your-openrouter-token
ENTERPRISE_LLM_TOKEN=replace-with-your-enterprise-provider-token
