# Copy to neo.yaml and adjust for your provider/model.
# neo.yaml is ignored by Git and may contain a local API key. Never commit it.

provider: openrouter
model: openai/gpt-4o-mini
api_key: replace-with-your-openrouter-token

# Reserved configuration: parsed and validated, but transcript compaction is
# not implemented in the Python port yet. This currently has no runtime effect.
compaction:
  context_window_tokens: 200000

features:
  agents_file: true     # Active: load applicable AGENTS.md instructions.
  skills: true          # Active: discover and expand Neo skills.
  # Reserved: parsed, but provider prompt caching is not implemented yet.
  prompt_caching: true

# Reserved configuration: parsed, but verbose tool rendering is not implemented
# in the Python REPL yet. This currently has no runtime effect.
output:
  verbose: false

# Optional named profile example:
# provider: enterprise
# providers:
#   - id: enterprise
#     name: Example Enterprise GPT
#     provider: openai
#     model: example.organization.language-model.gpt-5
#     apiBase: https://llm-gateway.example.com/openai/v1
#     api_key: replace-with-your-enterprise-token
#     protocol: chat_completions
#     max_tokens_parameter: max_completion_tokens
