# Copy to neo.yaml and adjust for your provider/model.
# Keep credentials in .env (for example OPENROUTER_API_KEY).

provider: openrouter
model: openai/gpt-4o-mini

compaction:
  context_window_tokens: 200000

features:
  agents_file: true
  skills: true
  prompt_caching: true

output:
  verbose: false

# Optional named profile example:
