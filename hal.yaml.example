# Copy to hal.yaml and adjust for your provider/model. Keep credentials in the
# ignored .env file when possible so routine config inspection cannot display them.

provider: openrouter
model: openai/gpt-4o-mini

# Git operations prefer the installed git executable and fall back to the
# required Dulwich Python backend. Set this to native or dulwich to require
# one backend explicitly.
git:
  backend: auto
  # backend: dulwich

# Restrict built-in write_file/edit_file calls to the Git workspace. Outside
# paths require interactive approval and are denied in headless mode. Shell and
# extension code cannot be path-confined by this setting; control model-issued
# shell access independently with bash_policy: normal, approve, or deny.
only_write_locally: true
bash_policy: normal

# Optional interactive confirmations. These are user-interface friction, not a
# security boundary, and literal prefixes do not detect every indirect command.
# tool_approvals:
#   - pip
#   - python -m pip
#   - py -m pip
#   - write_file
#   - edit_file
#   - git_commit
#   - git_push

# Reserved configuration: parsed and validated, but transcript compaction is
# not implemented in the Python port yet. This currently has no runtime effect.
compaction:
  context_window_tokens: 200000

# Optional hard limits for each agent send. Omit `harness.budgets` to preserve
# unlimited legacy behavior. Set an individual value to null to disable that limit.
# harness:
#   # Optional policy for ordinary sends: inspect, plan, change, or review.
#   # Workflow phases add their own capability and cannot weaken this one.
#   default_capability: change
#   budgets:
#     provider_calls: 50
#     tool_calls: 200
#     elapsed_seconds: 900
#     input_tokens: null
#     output_tokens: null
#   # Trusted commands run serially after a successful agent turn. These commands
#   # are configuration policy and are never accepted from model output.
#   verification:
#     - name: tests
#       command: .venv/bin/pytest -q
#       timeout_seconds: 120
#       required: true
#   # Optional bounded agent turns after required checks fail. Policy and budget
#   # counters carry across attempts. Defaults to zero.
#   repair_attempts: 1
#   # Custom policies may only narrow global budgets and caller/registry access.
#   capabilities:
#     docs:
#       description: Edit documentation with a small call budget
#       allowed_tools: [glob, grep, read_file, write_file]
#       denied_tools: [bash]
#       protect_existing_files: true
#       budgets:
#         provider_calls: 10
#         tool_calls: 20

features:
  agents_file: true     # Active: load applicable AGENTS.md instructions.
  skills: true          # Active: discover and expand HAL skills.
  # Active: incrementally display interactive responses. Set false for an
  # enterprise gateway that requires buffered Chat Completions. `hal run`
  # remains buffered regardless of this setting.
  streaming: true
  # Reserved: parsed, but provider prompt caching is not implemented yet.
  prompt_caching: true

# Optional trusted model-facing child profiles. The delegate tool can choose only a
# profile and task; policy and budgets remain fixed here and are narrowed by the parent.
# subagents:
#   researcher:
#     description: Inspect relevant code without modifying it
#     model: small-model
#     capability: inspect
#     budgets:
#       provider_calls: 10
#       tool_calls: 20
#       elapsed_seconds: 300

# Installed tool extensions are never loaded unless explicitly enabled here.
# extensions:
#   - jellyfin
# extension_config:
#   jellyfin:
#     url: http://localhost:8096

# Active in the TUI: concise tool receipts are the default; verbose mode shows
# complete call/result cards. The basic REPL retains its compact fixed view.
output:
  verbose: false

# Optional named profile example:
# provider: enterprise
# providers:
#   - id: enterprise
#     name: Example Enterprise GPT
#     provider: openai
#     model: example.organization.language-model.gpt-5
#     api_base_env: ENTERPRISE_LLM_BASE_URL
#     api_key_env: ENTERPRISE_LLM_TOKEN
#     protocol: chat_completions
#     max_tokens_parameter: max_completion_tokens
